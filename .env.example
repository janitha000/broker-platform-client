# Leave empty so the SPA calls /auth, /cases, /documents, and /audit on the same origin.
# Local: Vite proxies those paths to Identity (5250), Origination (5135), Document (5310), and Audit (5320).
# Production build already uses empty values (CloudFront path split).
VITE_IDENTITY_API_URL=
VITE_ORIGINATION_API_URL=
VITE_DOCUMENT_API_URL=
VITE_AUDIT_API_URL=
